@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolyo Admin - Deneyimlerim Yönetimi</title>
  
  <!-- Google Fonts: Plus Jakarta Sans / Manrope -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@await Component.InvokeAsync("_AdminLayoutStyleComponentPartial")
</head>
<body>

<div class="admin-wrapper">
  <!-- ==================== 1. LEFT SIDEBAR ==================== -->
  @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

  <!-- ==================== 2. MAIN CONTENT AREA ==================== -->
  <div class="admin-main">
    
    <!-- TOP NAVBAR -->
    @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

    <!-- CONTENT BODY -->
    @RenderBody()
  </div>
</div>


<!-- ==================== TOAST NOTIFICATION ==================== -->
<div class="toast-pill-success" id="actionToast">
  <i class="bi bi-check-circle-fill text-success" style="font-size: 1.25rem;"></i>
  <div>
    <div style="font-weight:600; font-size:0.85rem;" id="toastTitle">Başarılı</div>
    <div style="font-size:0.775rem; color:var(--text-secondary);" id="toastMsg">İşlem başarıyla gerçekleştirildi.</div>
  </div>
</div>

<!-- Vanilla JavaScript Interactions -->
@await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")

</body>
</html>