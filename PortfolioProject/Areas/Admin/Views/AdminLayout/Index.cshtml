@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="web_dashboard" name="shell-type">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&amp;family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    @await Component.InvokeAsync("_AdminLayoutStyleComponentPartial")

</head>
<body class="bg-surface font-body text-on-surface antialiased transition-colors duration-200">
    <!-- ================= RESPONSIVE BACKDROP OVERLAY ================= -->
    <div class="fixed inset-0 bg-black/60 z-40 hidden transition-opacity duration-300 lg:hidden" id="sidebar-backdrop"></div>
    <!-- ================= PERSISTENT RESPONSIVE SIDEBAR ================= -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
    <!-- ================= MAIN VIEWPORT CONTAINER ================= -->
    <div class="pl-0 lg:pl-72 flex flex-col min-h-screen transition-[padding] duration-300">
        <!-- Top Sticky Header -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")
        <!-- Main Content Area -->
        <main class="w-full pt-20 px-4 sm:px-8 pb-20 flex-1 flex flex-col gap-10">
            @RenderBody()
        </main>
    </div>
    <!-- ================= COMPREHENSIVE CONTROLLER SCRIPT ================= -->
    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")
</body>
</html>