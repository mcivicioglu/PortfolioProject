@{
    Layout = null;
}
<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="web_dashboard" name="shell-type">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&amp;family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&amp;family=Manrope:wght@200..800&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    @await Component.InvokeAsync("_AdminLayoutStyleComponentPartial")
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            "surface": "#faf9f6",
                            "surface-low": "#f4f3f0",
                            "surface-card": "#ffffff",
                            "surface-dim": "#efeeeb",
                            "surface-high": "#e3e2df",
                            "primary": "#121619",
                            "primary-container": "#252a2d",
                            "on-primary": "#ffffff",
                            "on-surface": "#191c1d",
                            "on-surface-variant": "#44474a",
                            "outline": "#74777a",
                            "outline-variant": "#c4c7c9",
                            "secondary": "#5f5b77",
                            "secondary-container": "#e2dbfd",
                            "tertiary": "#2e492b",
                            "tertiary-container": "#d9e7d0",
                            "error": "#ba1a1a",
                            "error-container": "#ffdad6"
                        },
                        fontFamily: {
                            sans: ["Manrope", "sans-serif"],
                            body: ["DM Sans", "sans-serif"],
                            mono: ["JetBrains Mono", "monospace"]
                        }
                    }
                }
            };
    </script>
</head>
<body class="bg-surface font-body text-on-surface antialiased transition-colors duration-200">
    <!-- ================= RESPONSIVE BACKDROP OVERLAY ================= -->
    <div class="fixed inset-0 bg-black/60 z-40 hidden transition-opacity duration-300 lg:hidden" id="sidebar-backdrop"></div>
    <!-- ================= PERSISTENT RESPONSIVE SIDEBAR ================= -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
    <!-- ================= MAIN VIEWPORT CONTAINER ================= -->
    <div class="pl-0 lg:pl-72 flex flex-col min-h-screen transition-[padding] duration-300">
        <!-- Top Sticky Header -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")
        <!-- Main Content Area -->
        <main class="w-full pt-20 px-4 sm:px-8 pb-20 flex-1 flex flex-col gap-10">
            <!-- ================= 00 / DASHBOARD SUMMARY SECTION ================= -->
            <section class="flex flex-col gap-6 pt-2" id="dashboard-top">
                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 pb-2 border-b border-outline-variant/30">
                    <div class="flex flex-col max-w-3xl">
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="font-mono text-xs uppercase tracking-wider text-secondary font-semibold">00 / SİSTEM GENEL BAKIŞ</span>
                            <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
                            <span class="font-mono text-xs text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded-full flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> DBSET REPOSITORY AKTİF
                            </span>
                        </div>
                        <h1 class="font-sans text-2xl sm:text-3xl font-extrabold tracking-tight text-primary">Portfolyo Yönetim &amp; Performans Paneli</h1>
                        <p class="font-body text-xs sm:text-sm text-on-surface-variant mt-1">Canlı portfolyo verileri, Entity Framework Core modelleri ve ana sayfanın tüm bölümleri tek ekrandan yönetilir.</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">

                        <a class="flex items-center gap-1.5 px-3.5 py-2 bg-primary text-on-primary hover:bg-primary-container rounded-lg text-xs font-sans font-semibold transition-colors shadow-xs" href="#sec-inbox">
                            <span class="material-symbols-outlined text-sm">mark_email_unread</span> Gelen Kutusu (38 Mesaj)
                        </a>
                    </div>
                </div>
                <!-- 4 KPI Metrics -->
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                    <!-- KART 1: PROJE SAYISI (Project.cs) -->
                    <div class="p-5 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-xs">
                        <div class="flex items-start justify-between">
                            <span class="font-mono text-[11px] uppercase tracking-wider text-outline font-semibold">PROJE SAYISI (Project.cs)</span>
                            <span class="p-1.5 rounded-lg bg-surface-low text-secondary"><span class="material-symbols-outlined text-lg">folder_open</span></span>
                        </div>
                        <div class="my-3 flex items-baseline justify-between">
                            <span class="font-sans text-3xl font-bold text-primary">14 <span class="text-sm font-normal text-on-surface-variant">Toplam</span></span>
                            <span class="font-mono text-xs px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-semibold">+%12 Bu Çeyrek</span>
                        </div>
                        <div class="text-xs text-on-surface-variant flex items-center justify-between pt-2 border-t border-outline-variant/20 font-mono">
                            <span>8 Canlı Yayın</span><span class="font-bold text-primary">6 Arşiv &amp; Taslak</span>
                        </div>
                    </div>
                    <!-- KART 2: EĞİTİM & SERTİFİKA (Education & Certificate.cs) -->
                    <div class="p-5 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-xs">
                        <div class="flex items-start justify-between">
                            <span class="font-mono text-[11px] uppercase tracking-wider text-outline font-semibold">EĞİTİM &amp; SERTİFİKA</span>
                            <span class="p-1.5 rounded-lg bg-surface-low text-secondary"><span class="material-symbols-outlined text-lg">workspace_premium</span></span>
                        </div>
                        <div class="my-3 flex items-baseline justify-between">
                            <span class="font-sans text-2xl font-bold text-primary">1 Derece &amp; 6 Sertifika</span>
                            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-surface-dim text-on-surface font-semibold">EF Sync</span>
                        </div>
                        <div class="text-xs text-on-surface-variant flex items-center justify-between pt-2 border-t border-outline-variant/20 font-mono">
                            <span>Doğrulama Durumu</span><span class="font-bold text-emerald-700">%100 Doğrulanabilir Link</span>
                        </div>
                    </div>
                    <!-- KART 3: GELEN MESAJLAR & ETKİLEŞİM (Contact.cs) with mini progress bar -->
                    <div class="p-5 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-xs">
                        <div class="flex items-start justify-between">
                            <span class="font-mono text-[11px] uppercase tracking-wider text-outline font-semibold">GELEN MESAJLAR &amp; ETKİLEŞİM</span>
                            <span class="p-1.5 rounded-lg bg-secondary-container text-secondary"><span class="material-symbols-outlined text-lg">contact_mail</span></span>
                        </div>
                        <div class="my-2">
                            <div class="flex items-baseline justify-between">
                                <span class="font-sans text-3xl font-bold text-primary">38 <span class="text-xs font-normal text-on-surface-variant">Mesaj</span></span>
                                <span class="font-mono text-xs px-2 py-0.5 rounded bg-error-container text-error font-semibold animate-pulse">2 Yanıt Bekleyen</span>
                            </div>
                            <!-- Mini progress representation -->
                            <div class="w-full bg-surface-dim h-2 rounded-full mt-2.5 overflow-hidden flex">
                                <div class="bg-primary h-full" style="width: 68%;" title="26 Okundu"></div>
                                <div class="bg-secondary h-full" style="width: 26%;" title="10 Yanıtlandı"></div>
                                <div class="bg-error h-full" style="width: 6%;" title="2 Bekleyen"></div>
                            </div>
                        </div>
                        <div class="text-[11px] text-on-surface-variant flex items-center justify-between pt-2 border-t border-outline-variant/20 font-mono">
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-primary inline-block"></span> 26 Okundu</span>
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-secondary inline-block"></span> 10 Yanıtlandı</span>
                        </div>
                    </div>
                    <!-- KART 4: CV VE GITHUB DÖNÜŞÜM -->
                    <div class="p-5 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col justify-between shadow-xs">
                        <div class="flex items-start justify-between">
                            <span class="font-mono text-[11px] uppercase tracking-wider text-outline font-semibold">CV &amp; GITHUB DÖNÜŞÜM</span>
                            <span class="p-1.5 rounded-lg bg-surface-low text-secondary"><span class="material-symbols-outlined text-lg">download</span></span>
                        </div>
                        <div class="my-3 flex items-baseline justify-between">
                            <span class="font-sans text-3xl font-bold text-primary">342</span>
                            <span class="font-mono text-xs px-2 py-0.5 rounded bg-surface-dim text-on-surface font-semibold">PDF İndirme</span>
                        </div>
                        <div class="text-xs text-on-surface-variant flex items-center justify-between pt-2 border-t border-outline-variant/20 font-mono">
                            <span>GitHub Tıklama</span><span class="font-bold text-primary">890 tık</span>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ================= SECTION EDITORS HEADER ================= -->
            <div class="flex items-center justify-between pt-4 border-t border-outline-variant/30">
                <div class="flex flex-col">
                    <div class="flex items-center gap-2">
                        <span class="font-mono text-xs uppercase tracking-wider text-secondary font-bold">ANA SAYFA BÖLÜM EDİTÖRLERİ</span>
                        <span class="font-mono text-[11px] px-2 py-0.5 bg-primary text-on-primary rounded font-semibold">10 AKTİF MODÜL SIRALANDI</span>
                    </div>
                    <h2 class="font-sans text-xl sm:text-2xl font-bold text-primary mt-1">Canlı Portfolyo İçerik ve Varlık Düzenleyicileri</h2>
                    <p class="font-body text-xs text-on-surface-variant">Ana sayfadaki sırayla listelenen tüm C# Entity Framework modellerini doğrudan buradan düzenleyebilirsiniz.</p>
                </div>
            </div>
            <!-- ================= 01 / HERO SECTION (HeroSection.cs) ================= -->
            <section class="p-6 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col gap-6 shadow-xs scroll-mt-20" id="sec-hero">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-outline-variant/20">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center font-mono text-xs font-bold">01</span>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs uppercase tracking-wider text-secondary font-bold">HERO BÖLÜMÜ</span>

                            </div>
                            <h3 class="font-sans text-lg font-bold text-primary">Hero Başlık, Unvan, Portre &amp; Terminal Profili</h3>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button class="px-3 py-1.5 bg-surface-low hover:bg-surface-dim rounded-lg text-xs font-mono text-on-surface flex items-center gap-1 transition-colors">
                            <span class="material-symbols-outlined text-sm">visibility</span> Canlıda Gör
                        </button>
                        <button class="px-3.5 py-1.5 bg-primary text-on-primary hover:bg-primary-container rounded-lg text-xs font-sans font-semibold flex items-center gap-1.5 transition-colors shadow-xs">
                            <span class="material-symbols-outlined text-sm">save</span> Hero Güncelle
                        </button>
                    </div>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-7 flex flex-col gap-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-1.5">
                                <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Karşılama Etiketi</label>
                                <input class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-xs font-body text-primary focus:outline-none focus:border-primary" type="text" value="Available for Senior Architecture Roles">
                            </div>
                            <div class="flex flex-col gap-1.5">
                                <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Unvan &amp; Rol</label>
                                <input class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-xs font-body text-primary focus:outline-none focus:border-primary" type="text" value="Lead Software Architect • .NET &amp; Cloud">
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Ana Başlık</label>
                            <input class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-sm font-sans font-bold text-primary focus:outline-none focus:border-primary" type="text" value="Kusursuz Mimari, Zarif Kod ve Sürdürülebilir Sistemler">
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Hero Biyografi Paragrafı</label>
                            <textarea class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-xs font-body text-primary focus:outline-none focus:border-primary min-h-[80px]" rows="3">Enterprise ölçekte .NET Core, mikroservis mimarileri ve yüksek erişilebilirlikli dağıtık sistemler inşa eden kıdemli yazılım mimarı. Performans odaklı, temiz ve tip güvenli çözümler tasarlarım.</textarea>
                        </div>
                    </div>
                    <div class="lg:col-span-5 flex flex-col gap-4">
                        <!-- Hero Image Preview & Integrated Upload Dropzone -->
                        <div class="p-3.5 bg-surface-low rounded-xl border border-outline-variant/30 flex flex-col gap-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <img alt="Hero Portrait" class="w-14 h-14 rounded-lg object-cover border border-outline-variant/40 shadow-xs" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBMlKEZpnB4CRXuU6bVh19KEmvOTuff-2xF74WpC0wg1yZaNR0QZkwaeDq-wcGk2sUSwk9jS_JbIIz1eiNi6jMk25nqkdTUJYBY-NLx9BBLqTWGP_v7koMyhKsGc3Fu9d1Qcc8o-NQfVCJY6kZfyMqvleBaWblIbe47VESV_5JxQ2u4EeRMlI-AGkAIedOvomq71wnqf22l3hX4RRD6BaYWUwY5LnQDIP9OgGPJfRLNRKMZHSO6Imzs5Q">
                                    <div class="flex flex-col">
                                        <span class="font-mono text-xs font-bold text-primary">Hero_Portrait.png</span>
                                        <span class="font-mono text-[11px] text-outline">1254x1254 • Aktif</span>
                                        <span class="font-mono text-[11px] text-emerald-700 font-semibold">Yayında</span>
                                    </div>
                                </div>
                                <button class="px-2.5 py-1.5 bg-primary text-on-primary hover:bg-primary-container rounded text-xs font-sans font-semibold flex items-center gap-1 transition-colors">
                                    <span class="material-symbols-outlined text-xs">upload_file</span> Yeni Görsel Yükle
                                </button>
                            </div>
                            <!-- Upload Dropzone / File Picker -->
                            <div class="border-2 border-dashed border-outline-variant/60 hover:border-primary rounded-lg p-3 bg-surface-card flex flex-col items-center justify-center text-center cursor-pointer transition-colors group">
                                <span class="material-symbols-outlined text-2xl text-secondary group-hover:text-primary transition-colors">cloud_upload</span>
                                <p class="font-sans text-xs font-semibold text-primary mt-1">Görsel Sürükleyin veya Dosya Seçin</p>
                                <p class="font-mono text-[10px] text-outline mt-0.5">PNG, JPG, WEBP (Maksimum 5MB) • 1:1 veya Portre Önerilir</p>
                            </div>
                        </div>
                        <!-- Terminal DeveloperProfile.cs Editor -->
                        <div class="flex flex-col gap-1.5">
                            <div class="flex items-center justify-between">
                                <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs">terminal</span> Terminal Profili&nbsp;
                                </label>
                                <span class="font-mono text-[10px] text-outline">C# Record</span>
                            </div>
                            <textarea class="font-mono text-xs leading-relaxed p-3 bg-primary-container text-surface-low rounded-lg border border-outline-variant/30 focus:outline-none focus:border-secondary h-32" rows="5" placeholder="public record DeveloperProfile {
                            public string Name { get; init; } = &quot;Mahmut&quot;;
                            public string Role { get; init; } = &quot;Junior .NET Developer&quot;;
                            public string Focus { get; init; } = &quot;.NET 8 &amp; Cloud Native&quot;;
                            public bool OpenToWork { get; init; } = true;
                            }">public record DeveloperProfile {
                            public string Name { get; init; } = "Mahmut";
                            public string Role { get; init; } = "Lead Software Architect";
                            public string Focus { get; init; } = ".NET 8 &amp; Cloud Native";
                            public bool OpenToWork { get; init; } = true;
                            }</textarea>
                        </div>
                    </div>
                </div>
            </section>
            <!-- ================= 02 / ABOUT SECTION (About.cs) ================= -->
            <section class="p-6 bg-surface-card rounded-xl border border-outline-variant/30 flex flex-col gap-6 shadow-xs scroll-mt-20" id="sec-about">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-outline-variant/20">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center font-mono text-xs font-bold">02</span>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs uppercase tracking-wider text-secondary font-bold">HAKKIMDA &amp; BİYOGRAFİ</span>

                            </div>
                            <h3 class="font-sans text-lg font-bold text-primary">Manifesto Alıntısı, Biyografi &amp; Editoryal Portre</h3>
                        </div>
                    </div>
                    <button class="px-3.5 py-1.5 bg-primary text-on-primary hover:bg-primary-container rounded-lg text-xs font-sans font-semibold flex items-center gap-1.5 transition-colors shadow-xs">
                        <span class="material-symbols-outlined text-sm">save</span> Biyografiyi Kaydet
                    </button>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-8 flex flex-col gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Manifesto / Vurgu Alıntısı</label>
                            <input class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-sm font-body italic text-primary focus:outline-none focus:border-primary" type="text" value="&quot;Fikirleri çalışan dijital ürünlere dönüştürüyorum. Temiz kod ve sürdürülebilir mimari.&quot;">
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label class="font-mono text-xs uppercase tracking-wider text-outline font-semibold">Detaylı Biyografi</label>
                            <textarea class="px-3 py-2 bg-surface-low border border-outline-variant/40 rounded-lg text-xs font-body text-primary focus:outline-none focus:border-primary min-h-[90px]" rows="3">6 yılı aşkın süredir modern yazılım ekosistemlerinde büyük ölçekli kurumsal uygulamalar, dağıtık mikroservis altyapıları ve bulut yerel çözümler geliştiriyorum. DDD ve Clean Architecture prensiplerini tavizsiz uygulayarak bakım maliyetlerini düşürürüm.</textarea>
                        </div>
                        <!-- Quick Metrics Grid -->
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-1">
                            <div class="p-2.5 bg-surface-low rounded-lg flex flex-col gap-0.5">
                                <label class="font-mono text-[10px] text-outline uppercase font-semibold">Konum</label>
                                <input class="bg-transparent font-sans text-xs font-bold text-primary focus:outline-none" type="text" value="İzmir, Türkiye">
                            </div>
                            <div class="p-2.5 bg-surface-low rounded-lg flex flex-col gap-0.5">
                                <label class="font-mono text-[10px] text-outline uppercase font-semibold">Uzmanlık</label>
                                <input class="bg-transparent font-sans text-xs font-bold text-primary focus:outline-none" type="text" value="Full Stack .NET">
                            </div>
                            <div class="p-2.5 bg-surface-low rounded-lg flex flex-col gap-0.5">
                                <label class="font-mono text-[10px] text-outline uppercase font-semibold">Odak Alanı</label>
                                <input class="bg-transparent font-sans text-xs font-bold text-primary focus:outline-none" type="text" value="Cloud &amp; DDD">
                            </div>
                            <div class="p-2.5 bg-surface-low rounded-lg flex flex-col gap-0.5">
                                <label class="font-mono text-[10px] text-outline uppercase font-semibold">Yaklaşım</label>
                                <input class="bg-transparent font-sans text-xs font-bold text-primary focus:outline-none" type="text" value="Clean Code &amp; UX">
                            </div>
                        </div>
                        <!-- DATABASE HISTORY & PREVIOUS REVISIONS LIST -->
                        <div class="mt-2 p-4 bg-surface-low rounded-xl border border-outline-variant/30 flex flex-col gap-3">
                            <div class="flex items-center justify-between pb-2 border-b border-outline-variant/20">
                                <div class="flex items-center gap-2">
                                    <span class="material-symbols-outlined text-sm text-secondary">history</span>
                                    <span class="font-mono text-xs uppercase tracking-wider text-primary font-bold">Veritabanı Geçmişi (Previous Revisions)</span>
                                </div>
                                <span class="font-mono text-[11px] text-outline">3 Kayıt Bulundu</span>
                            </div>
                            <div class="flex flex-col gap-2">
                                <!-- Revision 1 (Active) -->
                                <div class="p-2.5 bg-surface-card rounded-lg border border-primary/40 flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3">
                                        <input checked="" class="w-4 h-4 text-primary accent-primary focus:ring-0 cursor-pointer" id="rev-v24" name="about_active_revision" type="radio">
                                        <label class="flex flex-col cursor-pointer" for="rev-v24">
                                            <div class="flex items-center gap-2">
                                                <span class="font-sans font-bold text-xs text-primary">v2.4 - Aktif (Canlı)</span>
                                                <span class="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 rounded font-mono text-[10px] font-bold">Sitede Yayında</span>
                                            </div>
                                            <span class="font-mono text-[11px] text-outline">Güncellenme: 14 Ocak 2025 • Lead Software Architect odaklı revizyon</span>
                                        </label>
                                    </div>
                                    <span class="font-mono text-[11px] text-emerald-700 font-bold">Aktif Olarak Atandı</span>
