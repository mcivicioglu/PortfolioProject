<style>
    @@layer base {
        html, body {
            margin: 0;
            padding: 0;
        }

        body {
            overscroll-behavior: none;
        }

        main > :first-child {
            margin-top: 0 !important;
        }

        main > :last-child {
            margin-bottom: 0 !important;
        }
    }

    ::-webkit-scrollbar {
        display: none;
    }

    html {
        scroll-behavior: smooth;
    }

        /* Bulletproof Dark Theme Styles */
        html.dark {
            color-scheme: dark;
        }

            html.dark body {
                background-color: #121417 !important;
                color: #f3f4f6 !important;
            }
            /* Dark mode sidebar & header */
            html.dark aside {
                background-color: #16191e !important;
                border-color: #272d37 !important;
            }

            html.dark header {
                background-color: rgba(18, 20, 23, 0.95) !important;
                border-color: #272d37 !important;
            }
            /* Cards and Containers in Dark Mode */
            html.dark .bg-surface-card {
                background-color: #1a1e24 !important;
                border-color: #2e343d !important;
            }

            html.dark .bg-surface-low {
                background-color: #14171c !important;
                border-color: #272d37 !important;
            }

            html.dark .bg-surface-dim {
                background-color: #1f242c !important;
                border-color: #2e343d !important;
            }

            html.dark .bg-surface-high {
                background-color: #272d36 !important;
            }

            html.dark .border-outline-variant\/20,
            html.dark .border-outline-variant\/30,
            html.dark .border-outline-variant\/40,
            html.dark .border-outline-variant\/60 {
                border-color: #2e343d !important;
            }
            /* Text overrides in Dark Mode */
            html.dark .text-primary {
                color: #f8fafc !important;
            }

            html.dark .text-on-surface {
                color: #f1f5f9 !important;
            }

            html.dark .text-on-surface-variant {
                color: #94a3b8 !important;
            }

            html.dark .text-outline {
                color: #717d8e !important;
            }
            /* Inputs, selects, and textareas */
            html.dark input,
            html.dark textarea,
            html.dark select {
                background-color: #121417 !important;
                color: #f8fafc !important;
                border-color: #2e343d !important;
            }

                html.dark input:focus,
                html.dark textarea:focus,
                html.dark select:focus {
                    border-color: #94a3b8 !important;
                }
            /* Buttons in Dark Mode */
            html.dark .bg-primary {
                background-color: #f8fafc !important;
                color: #0d1013 !important;
            }

                html.dark .bg-primary:hover {
                    background-color: #e2e8f0 !important;
                }

                html.dark .bg-primary .material-symbols-outlined,
                html.dark .bg-primary span {
                    color: #0d1013 !important;
                }

            html.dark .bg-primary-container {
                background-color: #272f38 !important;
                color: #f8fafc !important;
            }

                html.dark .bg-primary-container * {
                    color: #f8fafc !important;
                }
            /* Badges & Accents in Dark Mode */
            html.dark .bg-emerald-100 {
                background-color: rgba(16, 185, 129, 0.18) !important;
                color: #34d399 !important;
            }

            html.dark .text-emerald-800,
            html.dark .text-emerald-700 {
                color: #34d399 !important;
            }

            html.dark .bg-error-container {
                background-color: rgba(239, 68, 68, 0.18) !important;
                color: #f87171 !important;
            }

            html.dark .bg-secondary-container {
                background-color: rgba(139, 92, 246, 0.2) !important;
                color: #c4b5fd !important;
            }

            html.dark .border-primary {
                border-color: #94a3b8 !important;
            }

            html.dark .border-primary\/20,
            html.dark .border-primary\/40 {
                border-color: rgba(255, 255, 255, 0.2) !important;
            }
</style>