<header class="fixed top-0 left-0 lg:left-72 right-0 h-16 bg-surface/90 backdrop-blur-md border-b border-outline-variant/30 z-30 px-4 sm:px-8 flex items-center justify-between transition-colors duration-200">
    <div class="flex items-center gap-3">
        <!-- Mobile Sidebar Toggle (Hamburger Button) -->
        <button aria-label="Menüyü Aç" class="lg:hidden flex items-center justify-center p-2 rounded-lg border border-outline-variant/40 text-on-surface-variant hover:bg-surface-low transition-colors" id="mobile-sidebar-toggle" type="button">
            <span class="material-symbols-outlined text-xl">menu</span>
        </button>
        <div class="flex items-center gap-2 font-mono text-xs text-on-surface-variant">
            <span class="font-bold text-primary">YÖNETİM PANELİ</span>
            <span class="hidden sm:inline">/</span>
            <span class="hidden sm:inline text-on-surface font-sans font-medium">BÖLÜMLER &amp; MERKEZİ KONTROL</span>
        </div>

    </div>
    <div class="flex items-center gap-2 sm:gap-3">
        <!-- Dynamic Dark/Light Mode Toggle Button -->
        <button aria-label="Karanlık Modu Aç/Kapat" class="p-2 text-on-surface-variant hover:text-on-surface hover:bg-surface-low rounded-lg transition-colors cursor-pointer flex items-center justify-center border border-outline-variant/30 sm:border-transparent" id="theme-toggle-btn" title="Koyu Modu Aç" type="button">
            <span class="material-symbols-outlined text-xl transition-transform duration-300" id="theme-toggle-icon">dark_mode</span>
        </button>
        <button class="flex items-center gap-1.5 bg-primary text-on-primary hover:bg-primary-container px-3 sm:px-4 py-2 rounded-lg font-sans text-xs font-semibold tracking-wide transition-all shadow-sm">
            <span class="material-symbols-outlined text-sm">publish</span> <span class="hidden sm:inline">Değişiklikleri</span> Yayınla
        </button>
    </div>
</header>
