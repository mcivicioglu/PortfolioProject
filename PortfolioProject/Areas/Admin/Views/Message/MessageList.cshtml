@model List<PortfolioProject.Entities.Message>
@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<div class="container">
<table class="table table-bordered col-7">
    <thead>
        <tr>
            <th>#</th>
            <th>Gönderen</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesajı Aç</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var message in Model)
        {
            <tr>
                <td>@message.MessageID</td>
                <td>@message.SenderName</td>
                <td>@message.Subject</td>
                <td>@message.SentDate.ToString("g")</td>
                <td>
                    <a href="/Admin/Message/MessageDetail/@message.MessageID" class="btn btn-info">Mesajı Aç</a>
                </td>
            </tr>
        }
    </tbody>
</table>