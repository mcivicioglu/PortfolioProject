@{
    Layout = null;
}
<!DOCTYPE html>
<html class="scroll-smooth" lang="tr">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>MC — Software Engineer &amp; Architect</title>
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&amp;family=JetBrains+Mono:wght@400;500;600&amp;family=Manrope:wght@500;600;700&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
    <script>
            (function () {
                try {
                    const storedTheme = localStorage.getItem('portfolio-theme');
                    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                    if (storedTheme === 'dark' || (!storedTheme && systemDark)) {
                        document.documentElement.classList.add('dark');
                    } else {
                        document.documentElement.classList.remove('dark');
                    }
                } catch (e) { }
            })();
    </script>
    <style>
            @@layer base {
                html, body {
                    margin: 0;
                    padding: 0;
                }

                main > :first-child {
                    margin-top: 0 !important;
                }

                main > :last-child {
                    margin-bottom: 0 !important;
                }
            }

            ::-webkit-scrollbar {
                display: none;
            }

            html.theme-transitioning, html.theme-transitioning * {
                transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease !important;
            }

            :root {
                --color-surface: #faf9f6;
                --color-surface-container: #efeeeb;
                --color-surface-container-low: #f4f3f0;
                --color-surface-container-high: #e9e8e5;
                --color-surface-container-highest: #e3e2df;
                --color-surface-container-lowest: #ffffff;
                --color-primary: #111618;
                --color-primary-container: #252a2d;
                --color-on-surface: #1a1c1a;
                --color-on-surface-variant: #44474a;
                --color-secondary: #5f5b77;
                --color-secondary-container: #e2dbfd;
                --color-tertiary-fixed: #d9e7d0;
                --color-tertiary-fixed-dim: #bdcbb5;
                --color-outline: #74777a;
                --color-outline-variant: #c4c7c9;
            }

            html.dark {
                --color-surface: #121314;
                --color-surface-container: #1c1d1f;
                --color-surface-container-low: #17181a;
                --color-surface-container-high: #242528;
                --color-surface-container-highest: #2d2e32;
                --color-surface-container-lowest: #141517;
                --color-primary: #f4f3f0;
                --color-primary-container: #2a2b2f;
                --color-on-surface: #f1f0ec;
                --color-on-surface-variant: #a1a1aa;
                --color-secondary: #a8a0d4;
                --color-secondary-container: #2e2a44;
                --color-tertiary-fixed: #243522;
                --color-tertiary-fixed-dim: #5c7553;
                --color-outline: #8e9094;
                --color-outline-variant: #34363a;
            }
    </style>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
            tailwind.config = {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "var(--color-primary)",
                            "primary-container": "var(--color-primary-container)",
                            surface: "var(--color-surface)",
                            "surface-container": "var(--color-surface-container)",
                            "surface-container-low": "var(--color-surface-container-low)",
                            "surface-container-high": "var(--color-surface-container-high)",
                            "surface-container-highest": "var(--color-surface-container-highest)",
                            "surface-container-lowest": "var(--color-surface-container-lowest)",
                            "on-surface": "var(--color-on-surface)",
                            "on-surface-variant": "var(--color-on-surface-variant)",
                            secondary: "var(--color-secondary)",
                            "secondary-container": "var(--color-secondary-container)",
                            "tertiary-fixed": "var(--color-tertiary-fixed)",
                            "tertiary-fixed-dim": "var(--color-tertiary-fixed-dim)",
                            outline: "var(--color-outline)",
                            "outline-variant": "var(--color-outline-variant)",
                        },
                        fontFamily: {
                            manrope: ["Manrope", "sans-serif"],
                            dmsans: ["DM Sans", "sans-serif"],
                            mono: ["JetBrains Mono", "monospace"]
                        }
                    }
                }
            };
    </script>
</head>
<body class="bg-surface font-dmsans text-on-surface antialiased selection:bg-secondary-container selection:text-secondary relative">

    <!-- TOP NAVBAR -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/85 backdrop-blur-xl border-b border-surface-container-highest/70">
        <div class="h-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
            <a class="flex items-center gap-1 group" href="#ana-sayfa">
                <span class="font-manrope text-xl text-primary font-bold tracking-tight">MC</span>
                <span class="h-1.5 w-1.5 rounded-full bg-secondary inline-block mb-1 group-hover:bg-primary transition-colors"></span>
            </a>
            <nav class="hidden lg:flex items-center gap-6 text-xs uppercase font-mono tracking-wider">
                <a class="text-primary font-semibold hover:text-secondary transition-colors" href="#ana-sayfa">Ana Sayfa</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#hakkimda">Hakkımda</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#yeteneklerim">Yeteneklerim</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#projelerim">Projelerim</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#deneyim">Deneyim</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#egitim">Eğitim</a>
                <a class="text-on-surface-variant hover:text-primary transition-colors" href="#iletisim">İletişim</a>
            </nav>
            <div class="flex items-center gap-3">
                <button aria-label="Temayı Değiştir" class="h-9 w-9 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface-variant hover:text-primary flex items-center justify-center border border-surface-container-highest/70 transition-all cursor-pointer" id="theme-toggle" type="button">
                    <span class="material-symbols-outlined text-[19px]" id="theme-toggle-icon">dark_mode</span>
                </button>
                <a class="inline-flex items-center gap-1.5 bg-primary text-surface hover:opacity-90 px-4 py-2 rounded-lg font-mono text-xs uppercase tracking-wider transition-all" href="#cv">
                    <span>CV İndir</span>
                    <span class="material-symbols-outlined text-[15px]">south</span>
                </a>
            </div>
        </div>
    </header>

    <!-- STICKY FLOATING SECTION NAVIGATOR (Right Sidebar) -->
    <aside aria-label="Bölüm Gezinme" class="fixed right-3 sm:right-6 top-1/2 -translate-y-1/2 z-40 hidden md:flex flex-col items-center gap-2 bg-surface/90 backdrop-blur-md p-1.5 rounded-full border border-surface-container-highest shadow-xl">
        <button aria-label="Önceki Bölüme Çık" class="global-prev-section h-8 w-8 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all cursor-pointer" title="Önceki Bölüm" type="button">
            <span class="material-symbols-outlined text-[18px]">keyboard_arrow_up</span>
        </button>
        <div class="w-4 h-[1px] bg-surface-container-highest"></div>
        <div class="flex flex-col gap-1.5 py-1" id="section-dots-nav">
            <a aria-label="Ana Sayfa" class="w-2 h-2 rounded-full bg-primary transition-all duration-300" data-nav-target="ana-sayfa" href="#ana-sayfa" title="Ana Sayfa"></a>
            <a aria-label="Hakkımda" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="hakkimda" href="#hakkimda" title="Hakkımda"></a>
            <a aria-label="Yeteneklerim" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="yeteneklerim" href="#yeteneklerim" title="Yeteneklerim"></a>
            <a aria-label="Projelerim" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="projelerim" href="#projelerim" title="Projelerim"></a>
            <a aria-label="Deneyim" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="deneyim" href="#deneyim" title="Deneyim"></a>
            <a aria-label="Eğitim" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="egitim" href="#egitim" title="Eğitim"></a>
            <a aria-label="Nasıl Çalışıyorum?" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="felsefe" href="#felsefe" title="Nasıl Çalışıyorum?"></a>
            <a aria-label="İletişim" class="w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300" data-nav-target="iletisim" href="#iletisim" title="İletişim"></a>
        </div>
        <div class="w-4 h-[1px] bg-surface-container-highest"></div>
        <button aria-label="Sonraki Bölüme İn" class="global-next-section h-8 w-8 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container transition-all cursor-pointer" title="Sonraki Bölüm" type="button">
            <span class="material-symbols-outlined text-[18px]">keyboard_arrow_down</span>
        </button>
    </aside>

    <main class="w-full pt-16">

        <!-- 1. HERO SECTION -->
        <section class="page-section relative w-full bg-surface py-20 lg:py-28" id="ana-sayfa">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    <div class="lg:col-span-7 flex flex-col items-start">
                        <div class="inline-flex items-center gap-2 bg-surface-container-high/70 px-3 py-1 rounded-full mb-6">
                            <span class="inline-block w-2 h-2 rounded-full bg-tertiary-fixed-dim"></span>
                            <span class="font-mono text-xs text-on-surface-variant font-medium">&lt; Merhaba, dünyama hoş geldin /&gt;</span>
                        </div>
                        <h1 class="font-manrope text-5xl sm:text-6xl text-primary font-bold tracking-tight">
                            Merhaba, Ben <span class="text-secondary underline decoration-secondary-container decoration-4 underline-offset-8">Mahmut</span>.
                        </h1>
                        <div class="h-12 mt-3 mb-4 flex items-center">
                            <span class="font-manrope text-2xl sm:text-3xl text-primary font-bold" id="typewriter-text">.NET Develo</span>
                            <span class="inline-block w-1 h-7 bg-primary ml-1 animate-pulse" id="typewriter-cursor"></span>
                        </div>
                        <p class="text-base sm:text-lg text-on-surface-variant max-w-xl mb-8 leading-relaxed">
                            Modern web teknolojileriyle performanslı, sürdürülebilir ve kullanıcı odaklı dijital deneyimler geliştiriyorum. Mimariden arayüze uçtan uca mühendislik hassasiyeti.
                        </p>
                        <div class="flex flex-wrap items-center gap-4">
                            <a class="inline-flex items-center gap-2 bg-primary text-surface hover:opacity-90 px-6 py-3 rounded-lg text-sm font-medium transition-all shadow-sm" href="#projelerim">
                                <span>Projelerimi Keşfet</span>
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                            </a>
                            <a class="inline-flex items-center gap-2 bg-surface-container hover:bg-surface-container-high text-on-surface px-6 py-3 rounded-lg text-sm font-medium transition-all border border-surface-container-highest" href="#iletisim">
                                <span>Benimle İletişime Geç</span>
                                <span class="material-symbols-outlined text-[18px]">north_east</span>
                            </a>
                        </div>
                        <div class="mt-12 flex flex-wrap items-center gap-8 font-mono text-xs text-on-surface-variant">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-tertiary-fixed-dim animate-ping"></span>
                                <span class="font-medium text-on-surface">✺ Çalışmaya ve yeni projelere hazır</span>
                            </div>
                            <div class="text-outline">LOC: 38.4225° N, 27.1311° E • IZM</div>
                        </div>
                    </div>
                    <div class="lg:col-span-5 relative">
                        <div class="relative bg-surface-container-low rounded-2xl p-4 shadow-md border border-surface-container-highest">
                            <div class="relative w-full h-[380px] rounded-xl overflow-hidden bg-surface-container">
                                <img alt="Mahmut - Full Stack Developer at dark moody desk setup" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/ALJJyrBgLoDWCT5Pn6bHGKB5zpkI9kXo7IOKNGgdIXmboaoDFyk4M9FCqeEGgAVLe28XWSchk3O4ScRUwJuKQ8fTOPR8mPXIm_98oBagPWk2v98O34GIj755URb7h87TiFRjO_trNrzHV0KWaLTIgj5CpWfoKyV6H_inPa8_xyyhtPMOY5aBZ7Nd0SswxLVHFX8s8zPf4jzUw1lNIrlYyBBKTswley11SY_xLO8JxopsA_G7Bd-kjBevArdOJGcw">
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                                <div class="absolute bottom-4 left-4 right-4 flex flex-wrap gap-1.5 font-mono text-xs">
                                    <span class="bg-surface/90 backdrop-blur-md px-2 py-0.5 rounded text-on-surface">C#</span>
                                    <span class="bg-surface/90 backdrop-blur-md px-2 py-0.5 rounded text-on-surface">ASP.NET Core</span>
                                    <span class="bg-surface/90 backdrop-blur-md px-2 py-0.5 rounded text-on-surface">SQL Server</span>
                                    <span class="bg-surface/90 backdrop-blur-md px-2 py-0.5 rounded text-on-surface">REST API</span>
                                </div>
                            </div>
                            <!-- Code Badge Card -->
                            <div class="-mt-8 -ml-4 relative bg-primary-container text-surface p-4 rounded-xl shadow-xl max-w-sm border border-outline-variant/30 font-mono text-xs">
                                <div class="flex items-center justify-between pb-2 mb-2 border-b border-outline-variant/20"><div class="flex items-center gap-1.5"><span class="w-2.5 h-2.5 rounded-full bg-red-500/80 inline-block"></span><span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span><span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span></div><span class="text-[11px] text-outline-variant">DeveloperProfile.cs</span><span class="text-tertiary-fixed text-[10px]">Open</span></div><pre class="text-[11px] leading-relaxed mb-3"><code><span class="text-secondary">public class</span> <span class="text-tertiary-fixed">DeveloperProfile</span> {
                                <span class="text-secondary">public string</span> Name =&gt; <span class="text-tertiary-fixed">Mahmut</span>;
                                <span class="text-secondary">public string</span> Role =&gt; <span class="text-tertiary-fixed">"Junior .NET Engineer"</span>;
                                <span class="text-secondary">public string</span> Focus =&gt; <span class="text-tertiary-fixed">"Web &amp; Cloud Arch."</span>;
                                <span class="text-secondary">public bool</span> OpenToWork =&gt; <span class="text-tertiary-fixed">true</span>;
                                }</code></pre><div class="flex items-center justify-between pt-2 border-t border-outline-variant/20 font-mono text-[10px]"><div class="flex items-center gap-1.5 text-outline-variant"><span>.NET 10.0</span><span>•</span><span>C# 14</span></div><div class="flex items-center gap-1 text-tertiary-fixed"><span class="w-1.5 h-1.5 rounded-full bg-tertiary-fixed animate-pulse"></span><span>Aktif Projelere Açık</span></div></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section Bottom Scroll Down Button -->
                <div class="flex justify-center mt-16">
                    <button class="section-nav-down group inline-flex flex-col items-center gap-1 font-mono text-xs text-on-surface-variant hover:text-primary transition-colors cursor-pointer" data-target="hakkimda" type="button">
                        <span>Aşağı Kaydır</span>
                        <span class="material-symbols-outlined text-[18px] group-hover:translate-y-1 transition-transform">south</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- 2. ABOUT ME -->
        <section class="page-section w-full py-24 bg-surface-container-low scroll-mt-16" id="hakkimda">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-baseline justify-between pb-4 mb-12 border-b border-surface-container-highest">
                    <div class="flex items-baseline gap-2">
                        <span class="font-mono text-xs text-secondary font-bold tracking-widest">01 /</span>
                        <span class="font-mono text-xs text-outline tracking-wider uppercase">BEN KİMİM?</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-1">
                            <button aria-label="Yukarı Kaydır" class="section-nav-up h-8 w-8 rounded-lg bg-surface hover:bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors border border-surface-container-highest cursor-pointer" data-target="ana-sayfa" title="Yukarı Kaydır (Ana Sayfa)" type="button">
                                <span class="material-symbols-outlined text-[18px]">arrow_upward</span>
                            </button>
                            <button aria-label="Aşağı Kaydır" class="section-nav-down h-8 w-8 rounded-lg bg-surface hover:bg-surface-container flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors border border-surface-container-highest cursor-pointer" data-target="yeteneklerim" title="Aşağı Kaydır (Yeteneklerim)" type="button">
                                <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
                            </button>
                        </div>
                        <h2 class="font-manrope text-3xl text-primary font-bold">Hakkımda</h2>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                    <div class="lg:col-span-5 relative">
                        <div class="bg-surface rounded-2xl p-4 shadow-sm border border-surface-container-highest">
                            <div class="relative w-full h-[400px] rounded-xl overflow-hidden bg-surface-container">
                                <img alt="Mahmut Portrait" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida/AEtjO1U6an9HW2kD_47V9MC8fK0DaTtlk6GmuSbNdPpZKmHqkZQvijcarNg8-EpjGuiOY7zbNQn987pylpY6sXM4H-1haSNR8yQ-VBdcEZ1xB4QQ4q6WrSvaTZvkBLz1RZaxYai2XZBpoKj0lNPn6cwmrCGw9y-yxjkhwb50aAMmujEPC0mel_RNGmFiO9Hosp2iPMutVkbzxmZog9atorqDrb60A3hB4dESom9ZdpPPH-oMT70JQsAtWX5T8oJT">
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-7 flex flex-col">
                        <p class="font-manrope text-2xl text-primary font-medium tracking-tight mb-6">
                            “Fikirleri çalışan dijital ürünlere dönüştürüyorum.”
                        </p>
                        <div class="space-y-4 text-on-surface-variant text-base leading-relaxed">
                            <p>
                                Merhaba, ben Mahmut. Modern web teknolojilerine ilgi duyan, kullanıcı deneyimini ve temiz kod yaklaşımını önemseyen bir yazılım geliştiriciyim. Kurumsal düzeyde .NET ekosistemi, modern önyüz çözümleri ve verimli veri tabanı mimarileri üzerine çalışıyorum.
                            </p>
                            <p>
                                Yazılım geliştirme sürecini karmaşık yapılar yerine; mühendislik disiplinine dayanan modüler, anlaşılır ve gelecekte kolayca ölçeklenebilen sistemler kurmak olarak yorumluyorum.
                            </p>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
                            <div class="bg-surface p-4 rounded-xl border border-surface-container-highest">
                                <span class="font-mono text-xs text-outline block mb-1">KONUM</span>
                                <span class="font-manrope font-semibold text-primary">İzmir, Türkiye</span>
                            </div>
                            <div class="bg-surface p-4 rounded-xl border border-surface-container-highest">
                                <span class="font-mono text-xs text-outline block mb-1">UZMANLIK</span>
                                <span class="font-manrope font-semibold text-primary">Web Dev</span>
                            </div>
                            <div class="bg-surface p-4 rounded-xl border border-surface-container-highest">
                                <span class="font-mono text-xs text-outline block mb-1">ODAK</span>
                                <span class="font-manrope font-semibold text-primary">Full Stack .NET</span>
                            </div>
                            <div class="bg-surface p-4 rounded-xl border border-surface-container-highest">
                                <span class="font-mono text-xs text-outline block mb-1">YAKLAŞIM</span>
                                <span class="font-manrope font-semibold text-primary">Clean Code</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. SKILLS -->
        <section class="page-section w-full py-24 bg-surface" id="yeteneklerim">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-baseline justify-between pb-4 mb-12 border-b border-surface-container-highest">
                    <div class="flex items-baseline gap-2">
                        <span class="font-mono text-xs text-secondary font-bold tracking-widest">02 /</span>
                        <span class="font-mono text-xs text-outline tracking-wider uppercase">TEKNOLOJİ EKOSİSTEMİ</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-1">
                            <button aria-label="Yukarı Kaydır" class="section-nav-up h-8 w-8 rounded-lg bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors border border-surface-container-highest cursor-pointer" data-target="hakkimda" title="Yukarı Kaydır (Hakkımda)" type="button">
                                <span class="material-symbols-outlined text-[18px]">arrow_upward</span>
                            </button>
                            <button aria-label="Aşağı Kaydır" class="section-nav-down h-8 w-8 rounded-lg bg-surface-container hover:bg-surface-container-high flex items-center justify-center text-on-surface-variant hover:text-primary transition-colors border border-surface-container-highest cursor-pointer" data-target="projelerim" title="Aşağı Kaydır (Projelerim)" type="button">
                                <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
                            </button>
                        </div>
                        <h2 class="font-manrope text-3xl text-primary font-bold">Yeteneklerim</h2>
                    </div>
