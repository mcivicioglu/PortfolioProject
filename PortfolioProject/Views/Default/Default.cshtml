<script>
        // THEME SWITCH LOGIC
        (function initTheme() {
            const themeBtn = document.getElementById('theme-toggle');
            const themeIcon = document.getElementById('theme-toggle-icon');
            const STORAGE_KEY = 'portfolio-theme';

            function isDark() { return document.documentElement.classList.contains('dark'); }
            function updateIcon(dark) {
                if (!themeIcon) return;
                themeIcon.textContent = dark ? 'light_mode' : 'dark_mode';
            }
            function applyTheme(dark) {
                document.documentElement.classList.add('theme-transitioning');
                if (dark) {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem(STORAGE_KEY, 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem(STORAGE_KEY, 'light');
                }
                updateIcon(dark);
                setTimeout(() => document.documentElement.classList.remove('theme-transitioning'), 300);
            }
            updateIcon(isDark());
            if (themeBtn) {
                themeBtn.addEventListener('click', () => applyTheme(!isDark()));
            }
        })();

        // SECTION SCROLL NAVIGATION (UP & DOWN BUTTONS)
        (function initSectionNavigation() {
            const sections = ['ana-sayfa', 'hakkimda', 'yeteneklerim', 'projelerim', 'deneyim', 'egitim', 'felsefe', 'iletisim'];

            function scrollToSection(id) {
                const el = document.getElementById(id);
                if (el) {
                    el.scrollIntoView({ behavior: 'smooth' });
                }
            }

            // Bind specific section nav buttons
            document.querySelectorAll('.section-nav-down').forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    if (targetId) scrollToSection(targetId);
                });
            });

            document.querySelectorAll('.section-nav-up').forEach(btn => {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    if (targetId) scrollToSection(targetId);
                });
            });

            // Global sticky prev/next arrows
            function getCurrentSectionIndex() {
                const scrollPos = window.scrollY + 200;
                for (let i = sections.length - 1; i >= 0; i--) {
                    const el = document.getElementById(sections[i]);
                    if (el && el.offsetTop <= scrollPos) {
                        return i;
                    }
                }
                return 0;
            }

            const prevBtn = document.querySelector('.global-prev-section');
            const nextBtn = document.querySelector('.global-next-section');

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    const idx = getCurrentSectionIndex();
                    if (idx > 0) scrollToSection(sections[idx - 1]);
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    const idx = getCurrentSectionIndex();
                    if (idx < sections.length - 1) scrollToSection(sections[idx + 1]);
                });
            }

            // Update dots indicator on scroll
            const dots = document.querySelectorAll('#section-dots-nav a');
            window.addEventListener('scroll', () => {
                const idx = getCurrentSectionIndex();
                dots.forEach((dot, dIdx) => {
                    if (dIdx === idx) {
                        dot.className = 'w-2 h-2 rounded-full bg-primary transition-all duration-300';
                    } else {
                        dot.className = 'w-2 h-2 rounded-full bg-outline-variant hover:bg-secondary transition-all duration-300';
                    }
                });
            }, { passive: true });
        })();

        // TYPEWRITER EFFECT
        (function initTypewriter() {
            const roles = ['Web Geliştirici', 'Full Stack Developer', '.NET Developer', 'Problem Çözücü'];
            let roleIndex = 0, charIndex = 0, isDeleting = false;
            const target = document.getElementById('typewriter-text');
            if (!target) return;

            function type() {
                const current = roles[roleIndex];
                if (isDeleting) {
                    target.textContent = current.substring(0, charIndex - 1);
                    charIndex--;
                } else {
                    target.textContent = current.substring(0, charIndex + 1);
                    charIndex++;
                }
                let speed = isDeleting ? 40 : 80;
                if (!isDeleting && charIndex === current.length) {
                    speed = 1500;
                    isDeleting = true;
                } else if (isDeleting && charIndex === 0) {
                    isDeleting = false;
                    roleIndex = (roleIndex + 1) % roles.length;
                    speed = 300;
                }
                setTimeout(type, speed);
            }
            type();
        })();

        // PROJECT FILTERS
        (function initProjectFilters() {
            const filterButtons = document.querySelectorAll('#project-filters .filter-btn');
            const projectItems = document.querySelectorAll('#projects-grid .project-item');

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterButtons.forEach(b => {
                        b.classList.remove('active', 'bg-primary', 'text-surface');
                        b.classList.add('bg-surface', 'text-on-surface-variant');
                    });
                    btn.classList.add('active', 'bg-primary', 'text-surface');
                    btn.classList.remove('bg-surface', 'text-on-surface-variant');
                    const filter = btn.getAttribute('data-filter');

                    projectItems.forEach(item => {
                        const cat = item.getAttribute('data-category');
                        item.style.display = (filter === 'all' || cat === filter) ? 'flex' : 'none';
                    });
                });
            });
        })();

