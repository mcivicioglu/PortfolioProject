            function updateSlider() {
                sliderTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
                counterEl.textContent = `${currentSlide + 1} / ${slidesData.length}`;
                captionEl.textContent = slidesData[currentSlide]?.caption || '';

                // Update dots
                sliderDots.querySelectorAll('.slider-dot').forEach((dot, idx) => {
                    dot.className = `slider-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${idx === currentSlide ? 'w-6 bg-primary' : 'w-2 bg-outline-variant'}`;
                });
            }

            function openModal(projectId) {
                const data = projects[projectId] || projects['1'];
                slidesData = data.slides;
                currentSlide = 0;

                document.getElementById('modal-title').textContent = data.title;
                document.getElementById('modal-category').textContent = data.category;
                document.getElementById('modal-date').textContent = data.date;
                document.getElementById('modal-problem').textContent = data.problem;
                document.getElementById('modal-architecture').textContent = data.architecture;
                document.getElementById('modal-github').href = data.github;
                document.getElementById('modal-demo').href = data.demo;

                // Render tags
                const tagsContainer = document.getElementById('modal-tags');
                tagsContainer.innerHTML = data.tags.map(t => `<span class="bg-surface-container px-2.5 py-1 rounded border border-surface-container-highest">${t}</span>`).join('');

                // Render slides
                sliderTrack.innerHTML = slidesData.map(s => `
                                      <div class="h-full w-full flex-shrink-0 relative">
                                        <img src="${s.url}" alt="${s.caption}" class="w-full h-full object-cover select-none" />
                                      </div>
                                    `).join('');

                // Render dots
                sliderDots.innerHTML = slidesData.map((_, idx) => `
                                      <button type="button" aria-label="Görsel ${idx + 1}" data-index="${idx}" class="slider-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${idx === 0 ? 'w-6 bg-primary' : 'w-2 bg-outline-variant'}"></button>
                                    `).join('');

                sliderDots.querySelectorAll('.slider-dot').forEach(dot => {
                    dot.addEventListener('click', () => {
                        currentSlide = parseInt(dot.getAttribute('data-index'));
                        updateSlider();
                    });
                });

                updateSlider();

                modal.classList.remove('opacity-0', 'pointer-events-none');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                modal.classList.add('opacity-0', 'pointer-events-none');
                document.body.style.overflow = '';
            }

            document.querySelectorAll('.open-modal-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const pId = this.getAttribute('data-project');
                    openModal(pId);
                });
            });

            if (closeBtn) closeBtn.addEventListener('click', closeModal);
            if (dismissBtn) dismissBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
            window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    currentSlide = (currentSlide - 1 + slidesData.length) % slidesData.length;
                    updateSlider();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    currentSlide = (currentSlide + 1) % slidesData.length;
                    updateSlider();
                });
            }
